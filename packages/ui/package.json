{
  "name": "@piant/ui",
  "version": "0.1.0",
  "description": "Piant Canvas UI 组件与布局基础",
  "keywords": [
    "piant",
    "ui",
    "canvas",
    "components"
  ],
  "homepage": "https://piant.sumygg.com/ui/introduction",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumy7/piant.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/sumy7/piant/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build -w",
    "test": "vitest",
    "test:run": "pnpm build && vitest run",
    "typecheck": "pnpm build && tsc --noEmit -p tsconfig.vitest.json",
    "verify:package": "node scripts/verifyPackage.mjs"
  },
  "peerDependencies": {
    "@piant/core": "workspace:^"
  },
  "devDependencies": {
    "@piant/babel-preset-piant": "workspace:*",
    "@piant/core": "workspace:*",
    "@rsbuild/plugin-babel": "2.1.0",
    "@rslib/core": "1.0.3",
    "happy-dom": "^21.0.3",
    "pixi.js": "^8.22.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=18.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "build",
          "^build",
          "{projectRoot}/rslib.config.ts",
          "{projectRoot}/tsconfig.build.json",
          "{workspaceRoot}/packages/babel-preset-piant/index.js"
        ]
      }
    }
  }
}
