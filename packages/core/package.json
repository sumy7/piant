{
  "name": "@piant/core",
  "version": "0.0.2-alpha.0",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "types.d.ts"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build -w",
    "test": "vitest",
    "test:run": "vitest run",
    "test:types": "tsc --noEmit -p tsconfig.vitest.json",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@chenglou/pretext": "1.0.0",
    "mobx": "^6.16.1",
    "pixi.js": "^8.22.0",
    "yoga-layout": "^3.2.1"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@rslib/core": "1.0.3",
    "@vitest/ui": "^5.0.5",
    "happy-dom": "^21.0.3",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
