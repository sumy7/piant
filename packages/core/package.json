{
  "name": "@piant/core",
  "version": "0.2.0",
  "description": "基于 PixiJS 和 Yoga 的声明式 Canvas UI 框架，支持 JSX、Flexbox 布局和细粒度响应式状态管理",
  "keywords": [
    "piant",
    "pixijs",
    "canvas",
    "webgl",
    "ui",
    "jsx",
    "flexbox",
    "reactivity"
  ],
  "homepage": "https://piant.sumygg.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumy7/piant.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/sumy7/piant/issues"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "types.d.ts"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build -w",
    "test": "vitest",
    "test:run": "vitest run",
    "test:types": "tsc --noEmit -p tsconfig.vitest.json",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@chenglou/pretext": "1.0.0",
    "mobx": "^6.16.1",
    "yoga-layout": "^3.2.1"
  },
  "peerDependencies": {
    "pixi.js": "^8.22.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@rslib/core": "1.0.3",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "happy-dom": "^21.0.3",
    "pixi.js": "^8.22.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=18.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
