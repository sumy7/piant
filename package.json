{
  "name": "piant-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "scripts/*"
  ],
  "scripts": {
    "build": "cross-env NX_DAEMON=false nx run-many -t build --exclude @examples/* @e2e/* --parallel=10",
    "changeset": "changeset",
    "postinstall": "pnpm -r --filter \"./packages/*\" --if-present run build",
    "pages:build": "node scripts/buildPages.mjs",
    "docs:build": "pnpm --filter @piant/monorepo-docs build",
    "docs:dev": "pnpm --filter @piant/monorepo-docs dev",
    "format": "prettier --write . && heading-case --write",
    "lint": "biome check",
    "sort-package-json": "pnpx sort-package-json \"./package.json\" \"packages/*/package.json\" \"packages/compat/*/package.json\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^2.31.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.20.5",
    "cross-env": "^10.1.0",
    "nx": "^23.3.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
